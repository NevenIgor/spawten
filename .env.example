# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,nginx
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_USERNAME=admin
# Язык Django-подсистемы: en | ru (переводы — в api/core/translations.py)
DJANGO_LANGUAGE=en

# Telegram bot
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
# Перевод нужен только в Django-подсистеме; бот говорит по-английски
# (тексты бота — tg_bot/bot/texts.py).


# Elasticsearch
ELASTIC_SEARCH_ENGINE_URL=http://elastic:9200
